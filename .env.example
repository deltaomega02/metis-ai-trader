# .env로 복사해 저장소 루트에 둔다 (gitignore 대상)

# true면 실거래 없이 paper_executor로 가상 체결
PAPER_MODE=false
# 페이퍼 모드 시작 잔고 (USDT)
PAPER_INITIAL_BALANCE=500.0

# 페이퍼 모드가 아닐 때 testnet 사용 여부
BYBIT_USE_TESTNET=true
BYBIT_API_KEY=
BYBIT_SECRET=
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

GEMINI_API_KEY=
